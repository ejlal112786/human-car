{
  "name": "city-racer",
  "private": true,
  "version": "0.1.0",
  "description": "City Racer: 3D city driving game with on-foot exploration, missions and races (Three.js + Rapier + TypeScript + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs dist",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:physics": "tsx scripts/physics-test.ts",
    "test:traffic": "tsx scripts/traffic-test.ts",
    "test:cyclists": "tsx scripts/cyclist-test.ts",
    "test:quaternius-traffic": "tsx scripts/quaternius-traffic-test.ts",
    "test:quaternius-assets": "node scripts/quaternius-assets-test.mjs",
    "test:peds": "tsx scripts/ped-test.ts",
    "test:crowd": "tsx scripts/crowd-pose-test.ts",
    "test:soak": "node --expose-gc --import tsx scripts/soak-test.ts",
    "test:vehicles": "tsx scripts/vehicles-test.ts",
    "test:progress": "tsx scripts/progress-test.ts",
    "test:nav": "tsx scripts/nav-test.ts",
    "test:damage": "tsx scripts/damage-test.ts",
    "test:police": "tsx scripts/police-test.ts",
    "test:career": "tsx scripts/career-test.ts",
    "test:campaign": "tsx scripts/campaign-test.ts",
    "test:crime": "tsx scripts/crime-test.ts",
    "test:jail": "tsx scripts/jail-test.ts",
    "test:crime-browser": "node scripts/crime-qa.mjs",
    "test:ads-browser": "node scripts/ads-qa.mjs",
    "test:police-browser": "node scripts/police-qa.mjs http://localhost:4174/",
    "build:qa": "tsc --noEmit && vite build --mode qa && node scripts/check-dist.mjs dist-qa --qa",
    "preview:qa": "vite preview --mode qa --host 0.0.0.0",
    "test:browser": "node scripts/browser-qa.mjs",
    "test:mobile": "node scripts/mobile-qa.mjs",
    "test:release": "node scripts/release-smoke.mjs",
    "test:parity": "node scripts/build-parity.mjs",
    "test:resources": "node scripts/resource-audit.mjs",
    "test:city": "node scripts/city-qa.mjs",
    "test:layout": "node scripts/layout-qa.mjs",
    "test:monkey": "node scripts/monkey-qa.mjs",
    "test:race-options": "node scripts/race-options-qa.mjs",
    "test:arrest-browser": "node scripts/arrest-qa.mjs",
    "test:setup-browser": "node scripts/setup-qa.mjs",
    "test:setup": "tsx scripts/setup-test.ts",
    "test:weather": "tsx scripts/weather-test.ts",
    "test:campaign-sample": "bash scripts/campaign-sample.sh",
    "test:weather-browser": "node scripts/weather-qa.mjs",
    "test:cockpit-browser": "node scripts/cockpit-qa.mjs",
    "test:input-combat": "tsx scripts/input-combat-test.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^7.3.7"
  }
}
